# --- Core infrastructure -----------------------------------------------------
# Local dev: docker compose maps Postgres to 5433 and Redis to 6380.
DATABASE_URL=postgresql://mentaagent:mentaagent@localhost:5433/mentaagent
REDIS_URL=redis://localhost:6380
PORT=3001

# --- LLM (agent brain) -------------------------------------------------------
# Easiest: leave these alone and paste a key on the app's Settings page ("Model
# & API key"). Anything saved there wins over the values below; blanks there
# fall back to these. With no key anywhere, the zero-spend stub provider gives
# canned answers (the whole pipeline still runs end to end).
#
# Any OpenAI-compatible chat host works. Default: DeepInfra, where ONE key
# serves chat, embeddings and vision.
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
AGENT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Heavier model for report executive-summary synthesis (pricier, sharper).
HEAVY_MODEL=deepseek-ai/DeepSeek-V4-Pro
LLM_TOOL_MODE=native
# Other proven options:
#   Nebius Hermes 4:  LLM_BASE_URL=https://api.studio.nebius.com/v1
#                     AGENT_MODEL=NousResearch/Hermes-4-70B  HEAVY_MODEL=NousResearch/Hermes-4-405B
#   DeepSeek direct:  LLM_BASE_URL=https://api.deepseek.com  AGENT_MODEL=deepseek-chat
#     (non-thinking, reliable for structured JSON; no embeddings endpoint there)
# Tool-call wire format: "native" (OpenAI tools param) or "hermes-xml" (schemas
# in the system prompt, <tool_call> blocks parsed from text — for hosts
# without native tool calling, e.g. Hermes 3 on DeepInfra).

# --- Embeddings (DeepInfra bge-m3; reuse the SAME DeepInfra key as the LLM) ---
EMBEDDINGS_BASE_URL=https://api.deepinfra.com/v1/openai
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# --- Vision (image ingest: photos/screenshots → text via a VLM) -------------
# Qwen3-VL on DeepInfra; reuses the SAME DeepInfra key as embeddings when
# VISION_API_KEY/VISION_BASE_URL are blank. Leave blank to disable image
# uploads (they're rejected at upload, never burning a quota slot).
# VISION_BASE_URL=https://api.deepinfra.com/v1/openai
# VISION_API_KEY=
VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
#   Heavier alt: VISION_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct

# Optional cap on total LLM spend per UTC day, in whole USD. 0 disables.
LLM_DAILY_USD_CAP=0

# --- Web <-> API -------------------------------------------------------------
# Shared secret so only the web server can call the API (>=32 chars; required
# when NODE_ENV=production). docker compose generates one.
INTERNAL_API_SECRET=
# Where the web server reaches the private API (internal network in prod).
API_INTERNAL_URL=http://localhost:3001
# Public origin of the web app, used for CORS. Set it before building if you
# serve the app on another address. Comma-separate to allow several.
WEB_ORIGIN=http://localhost:3000

# --- File storage -------------------------------------------------------------
# Local disk path for uploaded source files. Set the S3_* block only if the API
# and worker run on separate machines.
STORAGE_PATH=./data
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Connectors (Phase 3+) ----------------------------------------------------
# 32-byte hex key for AES-256-GCM encryption of connector OAuth tokens.
CONNECTOR_KEY=

# --- Observability --------------------------------------------------------------
SENTRY_DSN=
