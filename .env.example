# --- Core infrastructure -----------------------------------------------------
# Local dev (docker-compose maps to 5433/6380 so Mentapath's stack can coexist).
DATABASE_URL=postgresql://mentaagent:mentaagent@localhost:5433/mentaagent
REDIS_URL=redis://localhost:6380
PORT=3001

# --- LLM (agent brain) -------------------------------------------------------
# Any OpenAI-compatible chat host. Leave LLM_API_KEY unset to run with the
# zero-spend stub provider (agent loop still exercisable end-to-end).
#
# Active: DeepInfra (same provider Mentapath uses) — ONE DeepInfra key serves
# both chat and embeddings; paste it into LLM_API_KEY and EMBEDDINGS_API_KEY.
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
AGENT_MODEL=deepseek-ai/DeepSeek-V4-Flash
HEAVY_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_TOOL_MODE=native
# Other proven options:
#   Nebius Hermes 4:  LLM_BASE_URL=https://api.studio.nebius.com/v1
#                     AGENT_MODEL=NousResearch/Hermes-4-70B  HEAVY_MODEL=NousResearch/Hermes-4-405B
#   DeepSeek direct:  LLM_BASE_URL=https://api.deepseek.com  AGENT_MODEL=deepseek-chat
#     (non-thinking, reliable for structured JSON; no embeddings endpoint there)
# Tool-call wire format: "native" (OpenAI tools param) or "hermes-xml" (schemas
# in the system prompt, <tool_call> blocks parsed from text — for hosts
# without native tool calling, e.g. Hermes 3 on DeepInfra).

# --- Embeddings (DeepInfra bge-m3; reuse the SAME DeepInfra key as the LLM) ---
EMBEDDINGS_BASE_URL=https://api.deepinfra.com/v1/openai
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# Instance-wide soft cap on total LLM spend per UTC day, in whole USD.
# 0 disables. Fail-safe on top of per-workspace caps.
LLM_DAILY_USD_CAP=0

# --- Web <-> API trust boundary ----------------------------------------------
# Required in production (>=32 chars). The web proxy sends it as a bearer
# token; the API re-verifies (user, workspace) membership on every request.
INTERNAL_API_SECRET=

# --- Web app (apps/web) ------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Where the web server reaches the private API (internal network in prod).
API_INTERNAL_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# OAuth providers (optional; credentials auth works without them)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email (Resend; optional — features degrade gracefully) -------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- File storage -------------------------------------------------------------
# Local disk path for uploaded source files (dev). Set the S3_* block for
# multi-service deploys (API and worker have separate disks in prod).
STORAGE_PATH=./data
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Connectors (Phase 3+) ----------------------------------------------------
# 32-byte hex key for AES-256-GCM encryption of connector OAuth tokens.
CONNECTOR_KEY=

# --- Billing (Paddle; read by the WEB app) -------------------------------------
# Merchant of record. Leave unset and the billing page shows a "not configured"
# state; the webhook 500s until PADDLE_WEBHOOK_SECRET is set. See lib/plans.ts
# for what each tier maps to. PADDLE_ENVIRONMENT = sandbox | production.
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRO_PRICE_ID=
PADDLE_MAX_PRICE_ID=
PADDLE_WEBHOOK_SECRET=

# --- Observability --------------------------------------------------------------
SENTRY_DSN=
