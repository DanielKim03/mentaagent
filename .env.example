# --- Core infrastructure -----------------------------------------------------
# Local dev (docker-compose maps to 5433/6380 so Mentapath's stack can coexist).
DATABASE_URL=postgresql://mentaagent:mentaagent@localhost:5433/mentaagent
REDIS_URL=redis://localhost:6380
PORT=3001

# --- LLM (agent brain) -------------------------------------------------------
# Any OpenAI-compatible chat host. Leave LLM_API_KEY unset to run with the
# zero-spend stub provider (agent loop still exercisable end-to-end).
#
# Active: DeepInfra (same provider Mentapath uses) — ONE DeepInfra key serves
# both chat and embeddings; paste it into LLM_API_KEY and EMBEDDINGS_API_KEY.
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
AGENT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Heavier model for report executive-summary synthesis (pricier, sharper).
HEAVY_MODEL=deepseek-ai/DeepSeek-V4-Pro
LLM_TOOL_MODE=native
# Other proven options:
#   Nebius Hermes 4:  LLM_BASE_URL=https://api.studio.nebius.com/v1
#                     AGENT_MODEL=NousResearch/Hermes-4-70B  HEAVY_MODEL=NousResearch/Hermes-4-405B
#   DeepSeek direct:  LLM_BASE_URL=https://api.deepseek.com  AGENT_MODEL=deepseek-chat
#     (non-thinking, reliable for structured JSON; no embeddings endpoint there)
# Tool-call wire format: "native" (OpenAI tools param) or "hermes-xml" (schemas
# in the system prompt, <tool_call> blocks parsed from text — for hosts
# without native tool calling, e.g. Hermes 3 on DeepInfra).

# --- Embeddings (DeepInfra bge-m3; reuse the SAME DeepInfra key as the LLM) ---
EMBEDDINGS_BASE_URL=https://api.deepinfra.com/v1/openai
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# --- Vision (image ingest: photos/screenshots → text via a VLM) -------------
# Qwen3-VL on DeepInfra; reuses the SAME DeepInfra key as embeddings when
# VISION_API_KEY/VISION_BASE_URL are blank. Leave blank to disable image
# uploads (they're rejected at upload, never burning a quota slot).
# VISION_BASE_URL=https://api.deepinfra.com/v1/openai
# VISION_API_KEY=
VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
#   Heavier alt: VISION_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct

# Instance-wide soft cap on total LLM spend per UTC day, in whole USD.
# 0 disables. Fail-safe on top of per-workspace caps.
LLM_DAILY_USD_CAP=0

# --- Web <-> API trust boundary ----------------------------------------------
# Required in production (>=32 chars). The web proxy sends it as a bearer
# token; the API re-verifies (user, workspace) membership on every request.
INTERNAL_API_SECRET=

# --- Web app (apps/web) ------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Where the web server reaches the private API (internal network in prod).
API_INTERNAL_URL=http://localhost:3001
# Public origin of the web app. Used for CORS AND as the base for links in
# outbound emails, so set it to the deployed URL in production
# (e.g. https://your-app.up.railway.app). Comma-separate to allow several.
WEB_ORIGIN=http://localhost:3000

# OAuth providers (optional; credentials auth works without them)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email (Resend; optional — features degrade gracefully) -------------------
RESEND_API_KEY=
# Sender. In production use a verified Resend domain, with a display name:
#   EMAIL_FROM=MentaAgent <noreply@yourdomain.com>
EMAIL_FROM=onboarding@resend.dev

# --- File storage -------------------------------------------------------------
# Local disk path for uploaded source files (dev). Set the S3_* block for
# multi-service deploys (API and worker have separate disks in prod).
STORAGE_PATH=./data
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Connectors (Phase 3+) ----------------------------------------------------
# 32-byte hex key for AES-256-GCM encryption of connector OAuth tokens.
CONNECTOR_KEY=

# --- Billing (Paddle; read by the WEB app) -------------------------------------
# Merchant of record. Leave unset and the billing page shows a "not configured"
# state; the webhook 500s until PADDLE_WEBHOOK_SECRET is set. See lib/plans.ts
# for what each tier maps to. PADDLE_ENVIRONMENT = sandbox | production.
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRO_PRICE_ID=
PADDLE_MAX_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
# Paddle client-side token (Developer Tools → Authentication → Client-side
# tokens). Publishable; rendered into the /checkout page to open the Paddle.js
# overlay. test_... for sandbox, live_... for production. Paddle Billing has no
# hosted checkout page — checkout runs via Paddle.js, so add your domain under
# Checkout settings → approved domains.
PADDLE_CLIENT_TOKEN=

# --- Cloudflare Turnstile (bot/spam protection on signup) ---------------------
# Both read at runtime by the WEB app. Leave unset in dev (the widget renders
# nothing and verification is a no-op). In PRODUCTION a set secret is enforced
# fail-closed — if TURNSTILE_SECRET_KEY is set, signups without a valid token
# are rejected. Create a Turnstile widget in the Cloudflare dashboard for
# mentapath.com; it gives you a site key (public) and a secret key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability --------------------------------------------------------------
SENTRY_DSN=
