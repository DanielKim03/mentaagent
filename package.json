{
  "name": "mentaagent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose stop postgres redis",
    "db:migrate": "pnpm --filter api migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "^5.11.1",
      "fast-uri@<4": "^3.1.5",
      "form-data@<5": "^4.0.6",
      "@xmldom/xmldom@<0.9": "^0.8.15",
      "js-yaml@<4": "^3.15.2",
      "nanoid@<4": "^3.3.18",
      "postcss@<9": "^8.5.18"
    }
  }
}
