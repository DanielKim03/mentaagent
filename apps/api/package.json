    "@fastify/rate-limit": "^9.1.0",
    "@sentry/node": "^10.52.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.13.2",
    "dotenv": "^16.4.5",
    "expr-eval": "^2.0.2",
    "fastify": "^4.28.1",
    "file-type": "^22.0.1",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.4.1",
    "mailparser": "^3.9.9",
